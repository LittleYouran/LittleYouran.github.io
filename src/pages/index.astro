---
// 首页
import HeroCanvas from '../components/HeroCanvas.astro';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>youran 的博客</title>
    <meta name="description" content="技术折腾记录：Linux 桌面、内核编译、AI、游戏" />
    <style>
      :root {
        --bg-0: #0d0a16;
        --bg-1: #171226;
        --fg: #eee;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--bg-0);
        color: var(--fg);
        font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
        min-height: 100vh;
      }
      /* 顶部导航：浮在最上层 */
      .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 32px;
        background: rgba(13, 10, 22, 0.55);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }
      .site-header .logo {
        font-weight: 700;
        letter-spacing: 2px;
        color: #fff6e7;
        text-shadow: 0 2px 14px rgba(255, 130, 80, 0.45);
      }
      .site-header nav a {
        color: rgba(255, 255, 255, 0.75);
        text-decoration: none;
        margin-left: 24px;
        font-size: 14px;
        transition: color 0.2s;
      }
      .site-header nav a:hover { color: #fff; }

      /* 内容：正常流滚动，覆盖在固定背景之上 */
      .content {
        position: relative;
        z-index: 10;
        max-width: 860px;
        margin: 0 auto;
        padding: 0 24px;
      }
      /* 首屏占位：让标题区占满一屏，往下滚文字才上来 */
      .hero-pad {
        height: 100dvh;
        min-height: 480px;
        position: relative;
        z-index: 10;
        pointer-events: none;
      }
      .hero-overlay {
        position: absolute;
        left: 50%;
        bottom: 7%;
        top: auto;
        transform: translateX(-50%);
        z-index: 11;
        text-align: center;
        opacity: 0;
        transition: opacity 0.9s ease;
      }
      .hero-overlay.show { opacity: 1; }
      .hero-overlay h1 { font-size: 30px; letter-spacing: 3px; text-shadow: 0 2px 16px rgba(0,0,0,0.7); }
      .hero-overlay p { margin-top: 8px; font-size: 14px; opacity: 0.75; letter-spacing: 1px; }
      /* 前往下一页按钮 */
      .next-btn {
        display: inline-block;
        margin-top: 18px;
        padding: 10px 28px;
        border-radius: 40px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.28);
        color: #fff;
        font-size: 14px;
        letter-spacing: 2px;
        cursor: pointer;
        text-decoration: none;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.3s ease;
      }
      .next-btn:hover {
        background: rgba(255, 255, 255, 0.22);
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(255, 120, 60, 0.25);
      }
      .posts {
        max-width: 860px;
        margin: 0 auto 40px;
        padding: 48px 24px 24px;
        position: relative;
        z-index: 10;
        background: linear-gradient(180deg, rgba(13,10,22,0.85) 0%, rgba(13,10,22,0.97) 30%, var(--bg-0) 100%);
        border-radius: 18px 18px 0 0;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
      }
      .posts h2 {
        font-size: 22px;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      }
      .posts p { line-height: 1.9; opacity: 0.85; margin-bottom: 16px; }
      .about { padding: 0 24px 60px; max-width: 860px; margin: 0 auto; position: relative; z-index: 10; }
      .about h2 {
        font-size: 22px;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      }
      .about p { line-height: 1.9; opacity: 0.85; margin-bottom: 16px; }
      /* 第二页：大背景图 + 介绍 */
      .page2 {
        position: relative;
        z-index: 10;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      .page2-bg {
        position: absolute;
        inset: 0;
         background-image: url('/hero/v7/intro-bg.png');
        background-size: cover;
        background-position: center;
        z-index: 0;
      }
      .page2-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(13, 10, 22, 0.45);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
      }
      .page2-content {
        position: relative;
        z-index: 1;
        max-width: 680px;
        margin: 0 24px;
        padding: 40px;
        border-radius: 24px;
        background: rgba(13, 10, 22, 0.55);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-align: center;
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease, transform 0.8s ease;
      }
      .page2-content.visible {
        opacity: 1;
        transform: translateY(0);
      }
      .page2-content h2 { font-size: 28px; letter-spacing: 3px; margin-bottom: 20px; }
      .page2-content p { line-height: 2; opacity: 0.9; margin-bottom: 16px; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="logo">youran.dev</div>
      <nav>
        <a href="/">首页</a>
        <a href="#posts">文章</a>
        <a href="#about">关于</a>
      </nav>
    </header>

    <main>
      <!-- 固定背景：全屏粒子 hero（不随滚动移动） -->
      <HeroCanvas />

      <!-- 首屏占位：文字内容在正常流中，滚动时只有文字上去 -->
      <div class="hero-pad">
         <div class="hero-overlay">
           <a class="next-btn" href="/intro">前往下一页 <span aria-hidden="true">→</span></a>
        </div>
      </div>


      <section class="posts" id="posts">
        <h2>最近文章</h2>
        <p>博客搭建中，敬请期待。</p>
      </section>

      <section class="about" id="about">
        <h2>关于</h2>
        <p>这里是 youran 的技术折腾记录，主要写 Linux 桌面、内核编译、AI 应用和游戏相关的内容。</p>
      </section>
    </main>
    <script>
    </script>
  </body>
</html>
