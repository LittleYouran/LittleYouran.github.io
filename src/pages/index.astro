---
// 首页
import HeroCanvas from '../components/HeroCanvas.astro';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><circle cx=%2232%22 cy=%2232%22 r=%2228%22 fill=%22%23f39a43%22/><path d=%22M14 32h36M32 14c8 8 8 28 0 36M32 14c-8 8-8 28 0 36%22 stroke=%22%23ffd98a%22 stroke-width=%223%22 fill=%22none%22/></svg>" />
    <title>youran 的博客</title>
    <meta name="description" content="技术折腾记录：Linux 桌面、内核编译、AI、游戏" />
    <style>
      :root {
        --bg-0: #0d0a16;
        --bg-1: #171226;
        --fg: #eee;
      }
      @keyframes page-lift-off {
        0% { transform: translate3d(0, 0, 0) rotate(0deg) scale(1); opacity: 1; }
        55% { transform: translate3d(0, -18%, 0) rotate(-2deg) scale(1.035); opacity: 1; }
        100% { transform: translate3d(0, -112%, 0) rotate(-7deg) scale(1.08); opacity: 0; }
      }
      @keyframes sky-wash {
        0% { opacity: 0; transform: translateY(100%); }
        55% { opacity: .5; transform: translateY(22%); }
        100% { opacity: 1; transform: translateY(0); }
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--bg-0);
        color: var(--fg);
        font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
        min-height: 100vh;
        overflow: hidden;
      }
      body.page-leaving .hero-wrap,
      body.page-leaving .site-header,
      body.page-leaving .hero-pad {
        animation: page-lift-off 1.05s cubic-bezier(.18,.78,.2,1) forwards;
        transform-origin: 50% 100%;
      }
      body.page-leaving::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: 200;
        pointer-events: none;
        background: linear-gradient(180deg, rgba(111, 190, 230, 0) 0%, rgba(179, 226, 245, .9) 100%);
        animation: sky-wash 1.05s ease-out forwards;
      }
      /* Quiet floating navigation, without the previous black strip. */
      .site-header {
        position: fixed;
        top: 0;
        left: 50%;
        right: auto;
        transform: translateX(-50%);
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: min(92vw, 760px);
        margin-top: 14px;
        padding: 11px 18px;
        border-radius: 8px;
        background: rgba(215, 226, 239, 0.13);
        backdrop-filter: blur(16px) saturate(1.25);
        -webkit-backdrop-filter: blur(16px) saturate(1.25);
        border: 1px solid rgba(255, 255, 255, 0.24);
        box-shadow: 0 12px 36px rgba(5, 3, 14, 0.22), inset 0 1px rgba(255,255,255,.26);
      }
      .site-header .logo {
        font-weight: 700;
        letter-spacing: 2px;
        color: #fff6e7;
        text-shadow: 0 2px 14px rgba(255, 130, 80, 0.45);
      }
      .site-header nav a {
        color: rgba(255, 255, 255, 0.75);
        text-decoration: none;
        margin-left: 24px;
        font-size: 14px;
        transition: color 0.2s;
      }
      .site-header nav a:hover { color: #fff; }

      /* 内容：正常流滚动，覆盖在固定背景之上 */
      .content {
        position: relative;
        z-index: 10;
        max-width: 860px;
        margin: 0 auto;
        padding: 0 24px;
      }
      /* 首屏占位：让标题区占满一屏，往下滚文字才上来 */
      .hero-pad {
        height: 100dvh;
        min-height: 480px;
        position: relative;
        z-index: 10;
      }
      .hero-overlay {
        position: absolute;
        left: 50%;
        bottom: 7%;
        top: auto;
        transform: translateX(-50%);
        z-index: 100;
        text-align: center;
        opacity: 0;
        pointer-events: auto;
        transition: opacity 0.9s ease;
      }
      .hero-overlay.show { opacity: 1; }
      .hero-overlay h1 { font-size: 30px; letter-spacing: 3px; text-shadow: 0 2px 16px rgba(0,0,0,0.7); }
      .hero-overlay p { margin-top: 8px; font-size: 14px; opacity: 0.75; letter-spacing: 1px; }
      /* 前往下一页按钮 */
      .next-btn {
        display: inline-block;
        margin-top: 18px;
        padding: 10px 28px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.28);
        color: #fff;
        font-size: 14px;
        letter-spacing: 2px;
        cursor: pointer;
        text-decoration: none;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.3s ease;
        position: relative;
        z-index: 101;
        pointer-events: auto;
      }
      .next-btn:hover {
        background: rgba(255, 255, 255, 0.22);
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(255, 120, 60, 0.25);
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="logo">youran.dev</div>
      <nav>
        <a href="/">首页</a>
        <a href="/intro/">文章</a>
        <a href="/intro/">关于</a>
      </nav>
    </header>

    <main>
      <!-- 固定背景：全屏粒子 hero（不随滚动移动） -->
      <HeroCanvas />

      <!-- 首屏占位：文字内容在正常流中，滚动时只有文字上去 -->
      <div class="hero-pad">
         <div class="hero-overlay">
           <a class="next-btn" href="/intro/" aria-label="前往介绍页">前往下一页 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </main>
    <script>
      const next = document.querySelector('.next-btn');
      next?.addEventListener('click', (event) => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        event.preventDefault();
        document.body.classList.add('page-leaving');
        window.setTimeout(() => { window.location.href = next.href; }, 920);
      });
    </script>
  </body>
</html>
