---
const title = 'Till the Lands Become an Orange';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root { background: #081b3d; color: #f5f1e8; }
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; }
      body { overflow-x: hidden; font-family: Georgia, "Times New Roman", serif; }
      .sky {
        min-height: 100svh;
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg, #9dd8f1 0%, #d8eff5 52%, #081b3d 52%, #081b3d 100%);
        animation: rise 3.4s cubic-bezier(.22,.75,.2,1) both;
      }
      .sky::before, .sky::after {
        content: ""; position: absolute; left: -10%; width: 120%; height: 26vh;
        background: rgba(255,255,255,.42); filter: blur(28px); border-radius: 50%;
      }
      .sky::before { top: 18%; transform: rotate(-4deg); }
      .sky::after { top: 37%; transform: rotate(3deg); opacity: .55; }
      .title {
        position: absolute; inset: 52% 6% auto; text-align: center;
        color: #f29a3d; opacity: 0; transform: scale(.92);
        animation: title-in .9s 2.2s ease-out forwards;
        text-shadow: 0 4px 0 rgba(4,17,45,.28);
      }
      h1 { margin: 0; font-size: clamp(28px, 7vw, 76px); line-height: 1.05; font-style: italic; }
      .orange-o { display: inline-grid; place-items: center; width: .82em; height: .82em; border-radius: 50%; background: #f48b30; color: #183568; font-style: normal; box-shadow: inset 0 0 0 .08em #ffd17a, inset 0 0 0 .18em #ec6c25; }
      .back { position: absolute; top: 24px; left: 28px; color: #08204b; text-decoration: none; font: 600 14px system-ui, sans-serif; opacity: .72; }
      .intro { position: absolute; inset: auto 0 5%; text-align: center; font: 15px/1.8 system-ui, sans-serif; color: rgba(255,255,255,.82); opacity: 0; animation: title-in .8s 3s forwards; }
      @keyframes rise { from { transform: translateY(100%); filter: blur(10px); } to { transform: translateY(0); filter: blur(0); } }
      @keyframes title-in { to { opacity: 1; transform: scale(1); } }
      @media (prefers-reduced-motion: reduce) { .sky, .title, .intro { animation: none; opacity: 1; transform: none; } }
    </style>
  </head>
  <body>
    <main class="sky">
      <a class="back" href="/">← back</a>
      <section class="title" aria-label={title}>
        <h1>Till the Lands Become an <span class="orange-o">O</span>range</h1>
      </section>
      <p class="intro">Linux · AI · Kernel · Games<br />youran 的技术折腾记录</p>
    </main>
  </body>
</html>
