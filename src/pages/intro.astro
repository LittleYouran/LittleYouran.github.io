---
const title = 'Till the Lands Become an Orange';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><circle cx=%2232%22 cy=%2232%22 r=%2228%22 fill=%22%23f39a43%22/><path d=%22M14 32h36M32 14c8 8 8 28 0 36M32 14c-8 8-8 28 0 36%22 stroke=%22%23ffd98a%22 stroke-width=%223%22 fill=%22none%22/></svg>" />
    <title>{title}</title>
    <style>
      :root { background: #82c9ec; color: #fff; }
      @view-transition { navigation: auto; }
      ::view-transition-old(root) {
        animation: intro-old-up .72s cubic-bezier(.2,.76,.24,1) both;
      }
      ::view-transition-new(root) {
        animation: intro-new-arrive .74s cubic-bezier(.2,.78,.22,1) both;
      }
      @keyframes intro-old-up {
        to { opacity: 0; transform: translateY(-15%) scale(1.025); filter: blur(2px); }
      }
      @keyframes intro-new-arrive {
        from { opacity: 0; transform: translateY(12%) scale(1.018); filter: blur(2px); }
        to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; width: 100%; min-height: 100%; }
      body { overflow: hidden; font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; }
      .intro-page { position: relative; width: 100%; height: 100dvh; min-height: 480px; overflow: hidden; isolation: isolate; background: #82c9ec; }

      /* 最终背景从第一帧就在底层，转场只是在它上方掠过，不再先显示空底。 */
       .final-scene { position: absolute; inset: 0; z-index: 0; opacity: 1; transform: scale(1.018); animation: final-settle .55s .92s cubic-bezier(.2,.72,.2,1) forwards; background: #7fb8d1; }
      .scene { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
       .scene-main { z-index: 1; opacity: 1; animation: scene-main-drift 18s ease-in-out infinite alternate, scene-brighten .38s .5s ease-out forwards; }
      .scene-alt { z-index: 2; opacity: 0; animation: scene-alt-cycle 18s 6s ease-in-out infinite; }
       .scene-shade { position: absolute; inset: 0; z-index: 3; background: linear-gradient(90deg, rgba(10,31,51,.12) 0%, rgba(10,31,51,.025) 48%, transparent 78%), linear-gradient(0deg, rgba(7,24,40,.06), transparent 52%); }
       .copy { position: absolute; z-index: 4; left: clamp(28px, 8vw, 132px); top: 50%; width: min(42rem, 52vw); opacity: 0; transform: translateY(-39%); animation: copy-in .48s .98s cubic-bezier(.18,.82,.22,1) forwards; text-shadow: 0 3px 16px rgba(0,0,0,.52); }

      /* 整屏天空，不再在中间硬切深蓝。 */
      .sky-stage {
        position: absolute;
        inset: 0;
        z-index: 2;
        overflow: hidden;
        background: linear-gradient(180deg, #60b6e4 0%, #9fd9f1 48%, #e7f6fb 100%);
        transform: translateY(102%);
        filter: blur(10px);
        animation: rise-sky .46s cubic-bezier(.18,.82,.22,1) forwards, sky-away .28s .58s ease-in forwards;
      }
      .cloud { position: absolute; left: -15%; width: 130%; border-radius: 50%; background: rgba(255,255,255,.46); filter: blur(30px); }
      .cloud.one { top: 18%; height: 18%; transform: rotate(-4deg); }
      .cloud.two { top: 48%; height: 13%; opacity: .62; transform: rotate(3deg); }
      .cloud.three { top: 72%; height: 10%; opacity: .38; }

      .title-stage {
        position: absolute;
        inset: 0;
        z-index: 3;
        display: grid;
        place-items: center;
        background: #123c72;
        opacity: 0;
        transform: translateY(4%);
        animation: title-stage-in .22s .45s ease-out forwards, title-stage-out .3s 1.08s ease-in forwards;
      }
      .event-title { position: relative; margin: 0 6vw; text-align: center; color: #f5a34c; transform: scale(.94); animation: title-pop .34s .52s cubic-bezier(.2,.8,.2,1) forwards; }
      .event-title h1 { margin: 0; max-width: 1100px; font-family: Georgia, "Times New Roman", serif; font-style: italic; font-size: clamp(32px, 6.6vw, 86px); line-height: 1.05; letter-spacing: 0; text-shadow: 0 5px 0 rgba(4,17,45,.28); }
      .event-title::before, .event-title::after { content: "✦"; position: absolute; top: 50%; color: #ffd691; font-size: clamp(20px, 3vw, 42px); transform: translateY(-50%); }
      .event-title::before { left: -5vw; }
      .event-title::after { right: -5vw; }
      .orange-o { display: inline-grid; place-items: center; width: .82em; height: .82em; border-radius: 50%; background: repeating-conic-gradient(#ffc15f 0 12deg, #ed772c 12deg 24deg); border: .09em solid #ffd88b; color: #143c70; font-style: normal; vertical-align: -.04em; }

      /* 两张新图都作为完整全屏场景使用，不再缩进卡片，也不会重复使用首页图 3。 */
      .copy h2 { margin: 0; font-size: clamp(38px, 6vw, 82px); line-height: 1; letter-spacing: 0; }
      .copy .meow { margin: 16px 0 0; color: #ffd08b; font: 600 clamp(20px, 2.4vw, 34px)/1.4 Georgia, serif; }
      .copy .desc { max-width: 36rem; margin: 24px 0 0; color: rgba(255,255,255,.86); font-size: clamp(14px, 1.35vw, 18px); line-height: 1.85; }
      .back { position: absolute; z-index: 9; top: 24px; left: 28px; color: #fff; text-decoration: none; font-size: 14px; opacity: .84; text-shadow: 0 2px 8px rgba(0,0,0,.5); }

      @keyframes rise-sky { to { transform: translateY(0); filter: blur(0); } }
      @keyframes sky-away { to { opacity: 0; transform: translateY(-7%); } }
      @keyframes title-stage-in { to { opacity: 1; transform: translateY(0); } }
      @keyframes title-stage-out { to { opacity: 0; transform: translateY(-5%); } }
      @keyframes title-pop { to { transform: scale(1); } }
      @keyframes final-settle { to { transform: scale(1); } }
      @keyframes scene-brighten { to { opacity: 1; } }
      @keyframes copy-in { to { opacity: 1; transform: translateY(-45%); } }
      @keyframes scene-main-drift { from { transform: scale(1.015) translate3d(0, 0, 0); } to { transform: scale(1.055) translate3d(-1.2%, -.8%, 0); } }
      @keyframes scene-alt-cycle { 0%, 15% { opacity: 0; transform: scale(1.045); } 27%, 62% { opacity: 1; transform: scale(1); } 75%, 100% { opacity: 0; transform: scale(1.025); } }

      @media (max-width: 720px) {
        .copy { left: 24px; top: 38%; width: calc(100% - 48px); }
        .copy .desc { max-width: 72%; }
        .scene { object-position: 50% 50%; }
      }
      @media (orientation: landscape) and (max-height: 520px) {
        .intro-page { min-height: 0; height: 100dvh; }
        .copy { top: 52%; }
        .copy h2 { font-size: clamp(32px, 7vh, 52px); }
        .copy .meow { margin-top: 8px; }
        .copy .desc { margin-top: 12px; font-size: 13px; line-height: 1.6; }
      }
      @media (prefers-reduced-motion: reduce) {
        .sky-stage, .title-stage, .event-title, .final-scene, .scene, .copy { animation: none; }
        .sky-stage { transform: none; filter: none; }
        .title-stage { display: none; }
        .final-scene { opacity: 1; transform: none; }
        .copy { opacity: 1; transform: translateY(-45%); }
      }
    </style>
  </head>
  <body>
    <main class="intro-page">
      <div class="sky-stage" aria-hidden="true">
        <i class="cloud one"></i><i class="cloud two"></i><i class="cloud three"></i>
      </div>
      <section class="title-stage" aria-label={title}>
        <div class="event-title"><h1>Till the Lands Become an <span class="orange-o">O</span>range</h1></div>
      </section>
      <section class="final-scene">
         <img class="scene scene-main" src="/intro/v9/scene-six.png" alt="天空与角色场景" />
         <img class="scene scene-alt" src="/intro/v9/scene-a.webp" alt="另一段黄昏旅途场景" />
        <div class="scene-shade" aria-hidden="true"></div>
        <div class="copy">
          <h2>这里是掌柜</h2>
          <p class="meow">喵喵喵</p>
          <p class="desc">记录 Linux、内核、AI 和游戏，也记录那些折腾到深夜才终于跑通的瞬间。这里没有标准答案，只有一路试出来的经验。</p>
        </div>
      </section>
      <a class="back" href="/">返回首页</a>
    </main>
  </body>
</html>
