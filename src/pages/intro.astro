---
const title = 'Till the Lands Become an Orange';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><circle cx=%2232%22 cy=%2232%22 r=%2228%22 fill=%22%23f39a43%22/><path d=%22M14 32h36M32 14c8 8 8 28 0 36M32 14c-8 8-8 28 0 36%22 stroke=%22%23ffd98a%22 stroke-width=%223%22 fill=%22none%22/></svg>" />
    <title>{title}</title>
    <style>
      :root { background: #081b3d; color: #f5f1e8; }
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; }
      body { overflow-x: hidden; font-family: Georgia, "Times New Roman", serif; }
      .sky {
        min-height: 100svh;
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg, #9dd8f1 0%, #d8eff5 52%, #081b3d 52%, #081b3d 100%);
        animation: rise 1.25s cubic-bezier(.18,.82,.22,1) both;
      }
      .final-scene {
        position: absolute;
        inset: 0;
        z-index: 5;
        background: linear-gradient(rgba(10, 22, 42, .08), rgba(10, 22, 42, .28)), url('/hero/v8/intro-bg.webp') center / cover no-repeat;
        opacity: 0;
        transform: scale(1.045);
        animation: final-in 1.05s 3.05s cubic-bezier(.2,.72,.2,1) forwards;
      }
      .sky::before, .sky::after {
        content: ""; position: absolute; left: -10%; width: 120%; height: 26vh;
        background: rgba(255,255,255,.42); filter: blur(28px); border-radius: 50%;
      }
      .sky::before { top: 18%; transform: rotate(-4deg); }
      .sky::after { top: 37%; transform: rotate(3deg); opacity: .55; }
      .title {
        position: absolute; inset: 52% 6% auto; text-align: center;
        z-index: 4;
        color: #f29a3d; opacity: 0; transform: scale(.92);
        animation: title-in .72s 1.35s ease-out forwards, title-out .6s 2.75s ease-in forwards;
        text-shadow: 0 4px 0 rgba(4,17,45,.28);
      }
      h1 { margin: 0; font-size: clamp(28px, 7vw, 76px); line-height: 1.05; font-style: italic; }
      .orange-o { display: inline-grid; place-items: center; width: .82em; height: .82em; border-radius: 50%; background: #f48b30; color: #183568; font-style: normal; box-shadow: inset 0 0 0 .08em #ffd17a, inset 0 0 0 .18em #ec6c25; }
      .back { position: absolute; z-index: 8; top: 24px; left: 28px; color: #fff; text-decoration: none; font: 600 14px system-ui, sans-serif; opacity: .82; text-shadow: 0 2px 8px rgba(0,0,0,.35); }
      .intro { position: absolute; z-index: 7; inset: auto 0 5%; text-align: center; font: 15px/1.8 system-ui, sans-serif; color: rgba(255,255,255,.92); opacity: 0; text-shadow: 0 2px 12px rgba(0,0,0,.5); animation: title-in .7s 3.65s forwards; }
      @keyframes rise { from { transform: translateY(100%); filter: blur(10px); } to { transform: translateY(0); filter: blur(0); } }
      @keyframes title-in { to { opacity: 1; transform: scale(1); } }
      @keyframes title-out { to { opacity: 0; transform: scale(1.04) translateY(-12px); } }
      @keyframes final-in { to { opacity: 1; transform: scale(1); } }
      @media (prefers-reduced-motion: reduce) { .sky, .title, .intro, .final-scene { animation: none; opacity: 1; transform: none; } }
    </style>
  </head>
  <body>
    <main class="sky">
      <a class="back" href="/">← back</a>
      <section class="title" aria-label={title}>
        <h1>Till the Lands Become an <span class="orange-o">O</span>range</h1>
      </section>
      <div class="final-scene" aria-hidden="true"></div>
      <p class="intro">Linux · AI · Kernel · Games<br />youran 的技术折腾记录</p>
    </main>
  </body>
</html>
