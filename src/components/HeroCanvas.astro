---
// HeroCanvas.astro — 全屏亚克力贴纸 hero 组件
// 用法：
//   <HeroCanvas />
// 可选 props：
//   stickerBase: 贴纸目录 URL
//   gifSrc:      入场 GIF URL
//   followGifSrc:鼠标跟随 GIF URL
//   titleSrc:    大标题文字图 URL
//   titleDecoSrc:标题装饰角色图 URL
//   followSize:   跟随小角色尺寸 px（默认 82）
const {
  stickerBase = '/hero/v10/',
  gifSrc = '/hero/v8/runner.webp',
  followGifSrc = '/hero/v8/runner.webp',
  titleSrc = '/hero/v10/title.webp',
  titleDecoSrc = '/hero/v10/deco-14.webp',
  followSize = 82,
} = Astro.props;

// 首屏只保留 3（标题）、14 与 16（两张装饰）。
const stickers = [`${stickerBase}deco-16.webp`];
---

<div
  class="hero-wrap"
  data-gif={gifSrc}
  data-follow-gif={followGifSrc}
  data-stickers={stickers.join(',')}
  data-title={titleSrc}
  data-title-deco={titleDecoSrc}
  data-follow-size={followSize}
  aria-hidden="true"
></div>

<style is:global>
  /* 背景固定铺满全屏，不随滚动移动 */
  .hero-wrap {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: #9ed8f2;
  }
  .hero-sticker--single {
    filter: drop-shadow(0 12px 26px rgba(17, 78, 114, 0.3));
  }
  .hero-wrap * { pointer-events: none !important; }
  /* 像圆柱从布料下面滚过去形成的隆起，不是水面波纹。 */
  .hero-reveal-wave {
    position: absolute;
    left: 0;
    top: 50%;
    z-index: 9;
    width: clamp(300px, 48vw, 820px);
    height: 126vh;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(ellipse at 68% 48%, rgba(255,255,255,.58) 0 5%, rgba(223,245,255,.34) 15%, rgba(123,195,231,.16) 36%, transparent 66%),
      linear-gradient(90deg, transparent 0 23%, rgba(32,99,142,.26) 38%, rgba(255,255,255,.43) 59%, rgba(114,193,232,.12) 77%, transparent 100%);
    border: 1px solid rgba(239,251,255,.43);
    box-shadow: -48px 0 58px rgba(22,83,123,.28), 34px 0 48px rgba(255,255,255,.22), inset -18px 0 30px rgba(255,255,255,.2);
    filter: blur(2px);
    will-change: transform, opacity;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 48% 30%, rgba(239, 250, 255, 0.96) 0%, rgba(169, 220, 244, 0.92) 42%, rgba(95, 165, 207, 0.94) 100%);
  }
  .hero-acrylic {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    background:
      linear-gradient(118deg, rgba(255, 255, 255, 0.27) 0%, rgba(188, 230, 250, 0.1) 30%, rgba(242, 251, 255, 0.2) 67%, rgba(139, 205, 238, 0.11) 100%),
      rgba(147, 215, 244, 0.22);
    border: 1px solid rgba(239, 251, 255, 0.72);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.76),
      inset 0 -1px 0 rgba(61, 145, 190, 0.18),
      inset 18px 0 55px rgba(255, 255, 255, 0.1),
      0 18px 64px rgba(38, 108, 151, 0.18);
    backdrop-filter: blur(11px) saturate(1.15) brightness(1.08);
    -webkit-backdrop-filter: blur(11px) saturate(1.15) brightness(1.08);
    opacity: 0;
  }
  .hero-acrylic::before,
  .hero-acrylic::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-acrylic::before {
    opacity: 0.54;
    background:
      repeating-linear-gradient(90deg, rgba(249,254,255,.58) 0 1px, rgba(65,148,191,.08) 1px 2px, transparent 2px 14px),
      repeating-linear-gradient(0deg, rgba(249,254,255,.54) 0 1px, rgba(65,148,191,.07) 1px 2px, transparent 2px 14px);
  }
  .hero-acrylic::after {
    background:
      linear-gradient(104deg, transparent 8%, rgba(255,255,255,.34) 10%, rgba(174,224,247,.1) 12%, transparent 17%),
      linear-gradient(76deg, transparent 69%, rgba(255,255,255,.18) 72%, transparent 77%),
      radial-gradient(ellipse at 72% 18%, rgba(255,255,255,.23), transparent 27%),
      radial-gradient(ellipse at 20% 82%, rgba(201,237,255,.15), transparent 30%);
    mix-blend-mode: screen;
  }
  .hero-sticker-layer {
    position: absolute;
    inset: 0;
    z-index: 11;
    opacity: 0;
  }
  .hero-sticker {
    position: absolute;
    object-fit: contain;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.45));
    mix-blend-mode: normal;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  .hero-runner {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    pointer-events: none;
    will-change: transform;
    user-select: none;
    filter: drop-shadow(0 10px 24px rgba(255, 120, 60, 0.35));
    opacity: 0;
  }
  .hero-follow {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 6;
    pointer-events: none;
    will-change: transform, opacity;
    user-select: none;
    filter: drop-shadow(0 4px 14px rgba(255, 120, 60, 0.4));
    transition: opacity 0.25s;
  }
  /* 大标题：在全部揭幕完成后居中浮现 */
  .hero-title {
    position: absolute;
    left: 50%;
    top: 48%;
    transform: translate(-50%, -50%);
    z-index: 13;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    transition: opacity 0.9s ease;
  }
  .hero-title-img {
    max-width: min(72vw, 760px);
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.42));
  }
   /* 14 号装饰：放在标题上面（叠在“大地”大字上）。 */
  .hero-title-deco {
    position: absolute;
    left: 46%;
    bottom: 53%;
     max-width: min(20vw, 210px);
    width: 100%;
    height: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 10px 30px rgba(255, 120, 60, 0.35));
    z-index: 8;
  }
  .hero-rotate-tip {
    position: absolute;
    inset: 0;
    z-index: 9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.82);
    font-size: 18px;
    letter-spacing: 4px;
    background: rgba(13, 10, 22, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  /* 手机竖屏：提示横屏 */
  @media (max-width: 768px) and (orientation: portrait) {
    .hero-wrap {
      height: 100dvh;
    }
    .hero-title { top: 48%; width: 86vw; }
  }
</style>

<script>
  import { initHero } from '../lib/hero';

  const el = document.querySelector('.hero-wrap');
  if (el) {
    const gif = el.dataset.gif || '/hero/v5/gridley-clean.gif';
    const followGif = el.dataset.followGif || '/hero/v5/gridley-tiny-clean.gif';
    const stickers = (el.dataset.stickers || '').split(',').filter(Boolean);
    const title = el.dataset.title || '';
    const titleDeco = el.dataset.titleDeco || '';
    const followSize = Number(el.dataset.followSize) || 96;


    initHero(el, {
      gifSrc: gif,
      followGifSrc: followGif,
      stickers,
      titleSrc: title,
      titleDecoSrc: titleDeco,
      followSize,
      onTitleReady: () => {
        // 通知页面：标题已浮现，可以淡入正文内容
        document.querySelector('.hero-overlay')?.classList.add('show');
      },
    });
  }
</script>
