---
// HeroCanvas.astro — 全屏亚克力贴纸 hero 组件
// 用法：
//   <HeroCanvas />
// 可选 props：
//   stickerBase: 贴纸目录 URL
//   gifSrc:      入场 GIF URL
//   followGifSrc:鼠标跟随 GIF URL
//   titleSrc:    大标题文字图 URL
//   titleDecoSrc:标题装饰角色图 URL
//   followSize:   跟随小角色尺寸 px（默认 82）
const {
  stickerBase = '/hero/v8/',
  gifSrc = '/hero/v8/runner.webp',
  followGifSrc = '/hero/v8/runner.webp',
  titleSrc = '/hero/v8/title.webp',
  titleDecoSrc = '/hero/v8/deco.webp',
  followSize = 82,
} = Astro.props;

// sticker-3 是标题/星芒素材，不应再作为角色贴纸重复展示。
const stickerIds = [1, 2, 4, 5, 6, 7, 8, 9, 10, 11, 12];
const stickers = stickerIds.map((id) => `${stickerBase}sticker-${id}.webp`);
---

<div
  class="hero-wrap"
  data-gif={gifSrc}
  data-follow-gif={followGifSrc}
  data-stickers={stickers.join(',')}
  data-title={titleSrc}
  data-title-deco={titleDecoSrc}
  data-follow-size={followSize}
  aria-hidden="true"
></div>

<style is:global>
  /* 背景固定铺满全屏，不随滚动移动 */
  .hero-wrap {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: #0d0a16;
  }
  .hero-wrap * { pointer-events: none !important; }
  .hero-reveal-wave {
    position: absolute;
    left: 0;
    top: 50%;
    z-index: 9;
    width: clamp(120px, 14vw, 240px);
    height: 150vh;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(90deg, rgba(197, 226, 255, 0), rgba(228, 244, 255, 0.44), rgba(255, 201, 145, 0.16), rgba(197, 226, 255, 0));
    filter: blur(16px);
    mix-blend-mode: screen;
    will-change: transform, opacity;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 50% 38%, #7c7196 0%, #403752 58%, #171321 100%);
  }
  .hero-acrylic {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    background:
      linear-gradient(118deg, rgba(255, 255, 255, 0.48) 0%, rgba(202, 231, 246, 0.18) 31%, rgba(255, 255, 255, 0.32) 68%, rgba(164, 207, 231, 0.17) 100%),
      linear-gradient(90deg, rgba(207, 233, 248, 0.28), rgba(255, 255, 255, 0.13) 50%, rgba(166, 211, 235, 0.28)),
      rgba(173, 208, 229, 0.36);
    border: 2px solid rgba(255, 255, 255, 0.54);
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.48),
      inset 0 -2px 0 rgba(120, 169, 196, 0.2),
      inset 28px 0 70px rgba(255, 255, 255, 0.12),
      0 24px 80px rgba(4, 2, 12, 0.28);
    backdrop-filter: blur(18px) saturate(1.38) contrast(1.04);
    -webkit-backdrop-filter: blur(18px) saturate(1.38) contrast(1.04);
    opacity: 0;
  }
  .hero-acrylic::before,
  .hero-acrylic::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-acrylic::before {
    opacity: 1;
    background:
      repeating-linear-gradient(90deg, rgba(255,255,255,.58) 0 2px, rgba(66,126,161,.2) 2px 4px, transparent 4px calc(100vw / 6)),
      repeating-linear-gradient(0deg, rgba(236,249,255,.48) 0 2px, rgba(64,122,155,.16) 2px 4px, transparent 4px 20vh);
  }
  .hero-acrylic::after {
    background:
      linear-gradient(104deg, transparent 7%, rgba(255,255,255,.42) 9%, rgba(176,215,235,.13) 11%, transparent 16%),
      linear-gradient(76deg, transparent 68%, rgba(255,255,255,.22) 72%, transparent 77%),
      radial-gradient(ellipse at 72% 18%, rgba(255,255,255,.28), transparent 27%),
      radial-gradient(ellipse at 20% 82%, rgba(181,218,255,.16), transparent 30%);
    mix-blend-mode: screen;
  }
  .hero-sticker-layer {
    position: absolute;
    inset: 0;
    z-index: 11;
    opacity: 0;
  }
  .hero-sticker {
    position: absolute;
    object-fit: contain;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.45));
    mix-blend-mode: normal;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  .hero-runner {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    pointer-events: none;
    will-change: transform;
    user-select: none;
    filter: drop-shadow(0 10px 24px rgba(255, 120, 60, 0.35));
    opacity: 0;
  }
  .hero-follow {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 6;
    pointer-events: none;
    will-change: transform, opacity;
    user-select: none;
    filter: drop-shadow(0 4px 14px rgba(255, 120, 60, 0.4));
    transition: opacity 0.25s;
  }
  /* 大标题：在全部揭幕完成后居中浮现 */
  .hero-title {
    position: absolute;
    left: 50%;
    top: 48%;
    transform: translate(-50%, -50%);
    z-index: 13;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    transition: opacity 0.9s ease;
  }
  .hero-title-img {
    max-width: min(72vw, 760px);
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.42));
  }
  /* 翘腿角色装饰：放在标题上面（叠在"大地"大字上） */
  .hero-title-deco {
    position: absolute;
    left: 46%;
    bottom: 53%;
    max-width: min(24vw, 240px);
    width: 100%;
    height: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 10px 30px rgba(255, 120, 60, 0.35));
    z-index: 8;
  }
  .hero-rotate-tip {
    position: absolute;
    inset: 0;
    z-index: 9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.82);
    font-size: 18px;
    letter-spacing: 4px;
    background: rgba(13, 10, 22, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  /* 手机竖屏：提示横屏 */
  @media (max-width: 768px) and (orientation: portrait) {
    .hero-wrap {
      height: 100dvh;
    }
    .hero-title { top: 48%; width: 86vw; }
  }
</style>

<script>
  import { initHero } from '../lib/hero';

  const el = document.querySelector('.hero-wrap');
  if (el) {
    const gif = el.dataset.gif || '/hero/v5/gridley-clean.gif';
    const followGif = el.dataset.followGif || '/hero/v5/gridley-tiny-clean.gif';
    const stickers = (el.dataset.stickers || '').split(',').filter(Boolean);
    const title = el.dataset.title || '';
    const titleDeco = el.dataset.titleDeco || '';
    const followSize = Number(el.dataset.followSize) || 96;


    initHero(el, {
      gifSrc: gif,
      followGifSrc: followGif,
      stickers,
      titleSrc: title,
      titleDecoSrc: titleDeco,
      followSize,
      onTitleReady: () => {
        // 通知页面：标题已浮现，可以淡入正文内容
        document.querySelector('.hero-overlay')?.classList.add('show');
      },
    });
  }
</script>
