---
// HeroCanvas.astro — 全屏粒子角色 hero 组件（v5）
// 用法：
//   <HeroCanvas />
// 可选 props：
//   stickerBase: 贴纸目录 URL（默认 /hero/v5/，自动找 sticker-1..15.png）
//   gifSrc:      格里德利 GIF URL（默认 /hero/v5/gridley-clean.gif）
//   followGifSrc:跟随小 GIF URL（默认 /hero/v5/gridley-tiny-clean.gif）
//   titleSrc:    大标题文字图 URL
//   titleDecoSrc:标题装饰角色图 URL
//   stickerCount: 贴纸数量（默认 15）
//   followSize:   跟随小角色尺寸 px（默认 96）
const {
  stickerBase = '/hero/v6/',
  gifSrc = '/hero/v6/gridley-run.gif',
  followGifSrc = '/hero/v6/gridley-tiny-clean.gif',
  titleSrc = '/hero/v6/9F1DF0.png',
  titleDecoSrc = '/hero/v6/deco.png',
  stickerCount = 10,
  followSize = 96,
} = Astro.props;

const stickers = Array.from(
  { length: stickerCount },
  (_, i) => `${stickerBase}sticker-${i + 1}.png`,
);
---

<div
  class="hero-wrap"
  data-gif={gifSrc}
  data-follow-gif={followGifSrc}
  data-stickers={stickers.join(',')}
  data-title={titleSrc}
  data-title-deco={titleDecoSrc}
  data-follow-size={followSize}
  aria-hidden="true"
></div>

<style is:global>
  /* 背景固定铺满全屏，不随滚动移动 */
  .hero-wrap {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: #0d0a16;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 50% 40%, rgba(70, 55, 110, 0.45) 0%, rgba(35, 28, 60, 0.6) 60%, rgba(16, 12, 30, 0.85) 100%);
  }
  .hero-acrylic {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0) 35%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 40%);
    backdrop-filter: blur(3px) saturate(1.15);
    -webkit-backdrop-filter: blur(3px) saturate(1.15);
    opacity: 0;
  }
  .hero-sticker-layer {
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 0;
  }
  .hero-sticker {
    position: absolute;
    object-fit: contain;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.45));
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  .hero-runner {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    pointer-events: none;
    will-change: transform;
    user-select: none;
    filter: drop-shadow(0 10px 24px rgba(255, 120, 60, 0.35));
    opacity: 0;
  }
  .hero-follow {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 6;
    pointer-events: none;
    will-change: transform, opacity;
    user-select: none;
    filter: drop-shadow(0 4px 14px rgba(255, 120, 60, 0.4));
    transition: opacity 0.25s;
  }
  /* 大标题：浮在贴纸墙上，顶部居中 */
  .hero-title {
    position: absolute;
    left: 50%;
    top: 4%;
    transform: translateX(-50%);
    z-index: 7;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    transition: opacity 0.9s ease;
  }
  .hero-title-img {
    max-width: min(78vw, 780px);
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 28px rgba(0, 0, 0, 0.65));
  }
  /* 翘腿角色装饰：放在标题上面（叠在"大地"大字上） */
  .hero-title-deco {
    max-width: min(30vw, 300px);
    width: 100%;
    height: auto;
    margin-bottom: -12%;
    filter: drop-shadow(0 10px 30px rgba(255, 120, 60, 0.35));
    z-index: 8;
  }
  .hero-rotate-tip {
    position: absolute;
    inset: 0;
    z-index: 9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.82);
    font-size: 18px;
    letter-spacing: 4px;
    background: rgba(13, 10, 22, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  /* 手机竖屏：提示横屏 */
  @media (max-width: 768px) and (orientation: portrait) {
    .hero-wrap {
      height: 100dvh;
    }
    .hero-title {
      top: 2%;
    }
  }
</style>

<script>
  import { initHero } from '../lib/hero';

  const el = document.querySelector('.hero-wrap');
  if (el) {
    const gif = el.dataset.gif || '/hero/v5/gridley-clean.gif';
    const followGif = el.dataset.followGif || '/hero/v5/gridley-tiny-clean.gif';
    const stickers = (el.dataset.stickers || '').split(',').filter(Boolean);
    const title = el.dataset.title || '';
    const titleDeco = el.dataset.titleDeco || '';
    const followSize = Number(el.dataset.followSize) || 96;

    // 手机竖屏提示（纯 CSS 覆盖层，JS 不管）
    if (window.matchMedia('(max-width: 768px) and (orientation: portrait)').matches) {
      const tip = document.createElement('div');
      tip.className = 'hero-rotate-tip';
      tip.textContent = '请横屏浏览体验更佳';
      el.appendChild(tip);
    }

    initHero(el, {
      gifSrc: gif,
      followGifSrc: followGif,
      stickers,
      titleSrc: title,
      titleDecoSrc: titleDeco,
      followSize,
      onTitleReady: () => {
        // 通知页面：标题已浮现，可以淡入正文内容
        document.querySelector('.hero-overlay')?.classList.add('show');
      },
    });
  }
</script>
