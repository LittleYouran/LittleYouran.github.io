---
// HeroCanvas.astro — 全屏亚克力贴纸 hero 组件
// 用法：
//   <HeroCanvas />
// 可选 props：
//   stickerBase: 贴纸目录 URL（自动找 sticker-1..12.png）
//   gifSrc:      入场 GIF URL
//   followGifSrc:鼠标跟随 GIF URL
//   titleSrc:    大标题文字图 URL
//   titleDecoSrc:标题装饰角色图 URL
//   stickerCount: 贴纸数量（默认 12）
//   followSize:   跟随小角色尺寸 px（默认 96）
const {
  stickerBase = '/hero/v7/',
  gifSrc = '/hero/v7/runner-clean.gif',
  followGifSrc = '/hero/v7/runner-clean.gif',
  titleSrc = '/hero/v7/title.png',
  titleDecoSrc = '/hero/v7/deco.png',
  stickerCount = 12,
  followSize = 82,
} = Astro.props;

const stickers = Array.from(
  { length: stickerCount },
  (_, i) => `${stickerBase}sticker-${i + 1}.png`,
);
---

<div
  class="hero-wrap"
  data-gif={gifSrc}
  data-follow-gif={followGifSrc}
  data-stickers={stickers.join(',')}
  data-title={titleSrc}
  data-title-deco={titleDecoSrc}
  data-follow-size={followSize}
  aria-hidden="true"
></div>

<style is:global>
  /* 背景固定铺满全屏，不随滚动移动 */
  .hero-wrap {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: #0d0a16;
  }
  .hero-reveal-wave {
    position: absolute;
    left: 0;
    top: 50%;
    z-index: 4;
    width: clamp(120px, 14vw, 240px);
    height: 150vh;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(90deg, rgba(197, 226, 255, 0), rgba(228, 244, 255, 0.44), rgba(255, 201, 145, 0.16), rgba(197, 226, 255, 0));
    filter: blur(16px);
    mix-blend-mode: screen;
    will-change: transform, opacity;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 50% 38%, rgba(108, 88, 145, 0.58) 0%, rgba(49, 38, 72, 0.78) 58%, rgba(13, 10, 22, 0.96) 100%);
  }
  .hero-acrylic {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(125deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.07) 30%, rgba(255, 255, 255, 0.13) 68%, rgba(255, 255, 255, 0.04) 100%),
      rgba(175, 194, 218, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.32),
      inset 0 -1px 0 rgba(255, 255, 255, 0.08),
      0 24px 80px rgba(4, 2, 12, 0.34);
    backdrop-filter: blur(18px) saturate(1.35) contrast(1.04);
    -webkit-backdrop-filter: blur(18px) saturate(1.35) contrast(1.04);
    opacity: 0;
  }
  .hero-acrylic::before,
  .hero-acrylic::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-acrylic::before {
    opacity: 0.42;
    background:
      repeating-linear-gradient(100deg, rgba(255,255,255,.055) 0 1px, transparent 1px 7px),
      repeating-linear-gradient(8deg, rgba(214,232,255,.035) 0 1px, transparent 1px 9px);
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
  }
  .hero-acrylic::after {
    background:
      linear-gradient(104deg, transparent 9%, rgba(255,255,255,.18) 11%, transparent 15%),
      radial-gradient(ellipse at 72% 18%, rgba(255,255,255,.14), transparent 27%),
      radial-gradient(ellipse at 20% 82%, rgba(181,218,255,.1), transparent 30%);
    mix-blend-mode: screen;
  }
  .hero-sticker-layer {
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 0;
  }
  .hero-sticker {
    position: absolute;
    object-fit: contain;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.45));
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  .hero-runner {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    pointer-events: none;
    will-change: transform;
    user-select: none;
    filter: drop-shadow(0 10px 24px rgba(255, 120, 60, 0.35));
    opacity: 0;
  }
  .hero-follow {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 6;
    pointer-events: none;
    will-change: transform, opacity;
    user-select: none;
    filter: drop-shadow(0 4px 14px rgba(255, 120, 60, 0.4));
    transition: opacity 0.25s;
  }
  /* 大标题：在全部揭幕完成后居中浮现 */
  .hero-title {
    position: absolute;
    left: 50%;
    top: 48%;
    transform: translate(-50%, -50%);
    z-index: 7;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    transition: opacity 0.9s ease;
  }
  .hero-title-img {
    max-width: min(78vw, 780px);
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.42));
  }
  /* 翘腿角色装饰：放在标题上面（叠在"大地"大字上） */
  .hero-title-deco {
    max-width: min(30vw, 300px);
    width: 100%;
    height: auto;
    margin-bottom: -12%;
    filter: drop-shadow(0 10px 30px rgba(255, 120, 60, 0.35));
    z-index: 8;
  }
  .hero-rotate-tip {
    position: absolute;
    inset: 0;
    z-index: 9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.82);
    font-size: 18px;
    letter-spacing: 4px;
    background: rgba(13, 10, 22, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  /* 手机竖屏：提示横屏 */
  @media (max-width: 768px) and (orientation: portrait) {
    .hero-wrap {
      height: 100dvh;
    }
    .hero-title { top: 48%; width: 86vw; }
  }
</style>

<script>
  import { initHero } from '../lib/hero';

  const el = document.querySelector('.hero-wrap');
  if (el) {
    const gif = el.dataset.gif || '/hero/v5/gridley-clean.gif';
    const followGif = el.dataset.followGif || '/hero/v5/gridley-tiny-clean.gif';
    const stickers = (el.dataset.stickers || '').split(',').filter(Boolean);
    const title = el.dataset.title || '';
    const titleDeco = el.dataset.titleDeco || '';
    const followSize = Number(el.dataset.followSize) || 96;


    initHero(el, {
      gifSrc: gif,
      followGifSrc: followGif,
      stickers,
      titleSrc: title,
      titleDecoSrc: titleDeco,
      followSize,
      onTitleReady: () => {
        // 通知页面：标题已浮现，可以淡入正文内容
        document.querySelector('.hero-overlay')?.classList.add('show');
      },
    });
  }
</script>
